{
  "name": "badge-bump-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "USB-serial bridge: HTN badge knock events -> MongoDB Atlas time series + live page",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "init": "node --env-file-if-exists=.env init-db.mjs",
    "bridge": "node --env-file-if-exists=.env bridge.mjs",
    "seed": "node --env-file-if-exists=.env seed.mjs",
    "verify": "node verify-local.mjs"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "mongodb": "^7.7.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
