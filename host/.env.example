# Copy to .env  (node --env-file=.env reads it; .env is gitignored)
# Atlas free M0. Get this from Atlas -> Connect -> Drivers -> Node.js.
# Keep the real .env OUT of the public repo -- the repo is part of what gets judged.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=badge

# The badge's serial port. Verified present as COM3 on this machine
# (USB Serial Device, VID_303A&PID_1001). It CAN change after entering
# download mode -- re-check Device Manager if the bridge cannot open it.
BADGE_PORT=COM3
BADGE_BAUD=115200

# Stamped into meta.badgeId. Keep it low-cardinality: metaField is indexed
# and a high-cardinality meta defeats time series bucketing.
BADGE_ID=badge-01
BADGE_FW=bump-1.0

HTTP_PORT=8080
