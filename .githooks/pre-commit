#!/bin/sh
# pre-commit — formatting check and a build-artifact guard.
#
# Both checks degrade gracefully: if clang-format is not installed, the format
# check is skipped with a note rather than blocking the commit. A hook that
# fails because of a missing optional tool just teaches people --no-verify.

status=0

staged_files() {
  git diff --cached --name-only --diff-filter=ACM
}

# ── 1. clang-format on staged C/C++ ───────────────────────────────────────
cpp_files=$(staged_files | grep -E '\.(c|cc|cpp|h|hpp|ino)$' || true)

if [ -n "$cpp_files" ]; then
  if command -v clang-format >/dev/null 2>&1; then
    unformatted=''
    for f in $cpp_files; do
      [ -f "$f" ] || continue
      if ! clang-format --style=file --dry-run -Werror "$f" >/dev/null 2>&1; then
        unformatted="$unformatted  $f
"
      fi
    done

    if [ -n "$unformatted" ]; then
      printf '\n  ✗ Not clang-format clean:\n%s\n' "$unformatted" >&2
      printf '  Fix with: clang-format -i --style=file %s\n\n' \
        "$(printf '%s' "$cpp_files" | tr '\n' ' ')" >&2
      status=1
    fi
  else
    printf '  ! clang-format not installed; skipping format check\n' >&2
  fi
fi

# ── 2. Build artifacts and oversized files ────────────────────────────────
# This repo's .gitignore already covers .pio/ and binaries, but a `git add -f`
# or a stale checkout can still sneak them in, and a committed toolchain blob
# is miserable to remove from history later.
max_bytes=2097152  # 2 MiB

for f in $(staged_files); do
  [ -f "$f" ] || continue

  case "$f" in
    *.bin|*.elf|*.hex|*.map|*/.pio/*|.pio/*|*/node_modules/*)
      printf '  ✗ %s looks like a build artifact — should not be committed\n' \
        "$f" >&2
      status=1
      continue
      ;;
  esac

  size=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
  [ -n "$size" ] || continue
  if [ "$size" -gt "$max_bytes" ]; then
    printf '  ✗ %s is %s bytes (over 2 MiB)\n' "$f" "$size" >&2
    printf '    Large assets belong in a release, not in git history.\n' >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  printf '\n  Bypass once, knowingly: git commit --no-verify\n\n' >&2
fi

exit "$status"
